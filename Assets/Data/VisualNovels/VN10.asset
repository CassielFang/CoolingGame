        m_Calls: []
  - Background: 
    LeftPortrait: "\u83AB\u91CC\u68EE"
    RightPortrait: 
    Speaker: "\u83AB\u91CC\u68EEMorrison"
    Line: "\u5361\u6797\u987F\u7235\u58EB\u5728\u8BAE\u4F1A\u4EE5\u5F3A\u786C\u8457\u79F0\uFF0C\u800C\u7EA6\u7FF0\u5728\u751F\u6D3B\u4E2D\u5219\u5B8C\u5168\u770B\u4E0D\u5230\u4ED6\u7236\u4EB2\u7684\u5F71\u5B50\uFF0C\u4ED6\u7ECF\u5E38\u524D\u5F80\u6D4E\u8D2B\u9662\u3001\u6559\u5802\u505A\u6148\u5584\uFF0C\u8FD8\u7ECF\u5E38\u53C2\u4E0E\u4E00\u5BB6\u8BFB\u4E66\u6C99\u9F99\u7684\u6D3B\u52A8\u3002"
