    Speaker: "\u83AB\u91CC\u68EEMorrison"
    Line: "\u8FD9\u573A\u95EE\u8BDD\u5C31\u662F\u4E00\u573A\u707E\u96BE\uFF0C\u6211\u4EEC\u5F53\u65F6\u5E76\u4E0D\u77E5\u9053\uFF0C\u6B7B\u8005\u662F\u90E1\u8BAE\u5458\u5361\u6797\u987F\u7235\u58EB\u7684\u957F\u5B50\uFF0C\u800C\u5361\u6797\u987F\u7235\u58EB\u7684\u6001\u5EA6\u5F88\u5DEE\uFF0C\u6211\u4EEC\u53EA\u80FD\u5411\u5361\u6797\u987F\u592B\u4EBA\u8BE2\u95EE\u6B7B\u8005\u7684\u60C5\u51B5\u3002"
