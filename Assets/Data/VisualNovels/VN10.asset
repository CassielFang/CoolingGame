        m_Calls: []
  - Background: 
    LeftPortrait: "\u83AB\u91CC\u68EE"
    RightPortrait: 
    Speaker: "\u83AB\u91CC\u68EEMorrison"
    Line: "\u5361\u6797\u987F\u7235\u58EB\u7684\u957F\u5B50\u53EB\u7EA6\u7FF0\uFF0C\u4ED6\u548C\u5361\u6797\u987F\u7235\u58EB\u5411\u6765\u4E0D\u548C\uFF0C\u751F\u6D3B\u4F5C\u98CE\u4E5F\u76F8\u53BB\u751A\u8FDC\u3002"
    BeforeLine:
      m_PersistentCalls:
        m_Calls: []
    AfterLine:
      m_PersistentCalls:
        m_Calls: []
  - Background: 
    LeftPortrait: "\u83AB\u91CC\u68EE"
    RightPortrait: 
    Speaker: "\u83AB\u91CC\u68EEMorrison"
    Line: "\u7EA6\u7FF0\u751F\u6D3B\u5341\u5206\u4F4E\u8C03\uFF0C\u4E0E\u7236\u4EB2\u95F9\u63B0\u540E\uFF0C\u4FBF\u72EC\u81EA\u4F4F\u5728\u4E86\u516C\u5BD3\u4E2D\uFF0C\u623F\u4E1C\u3001\u8EAB\u8FB9\u7684\u670B\u53CB\uFF0C\u5728\u8FD9\u4EF6\u4E8B\u4E4B\u524D\u90FD\u4E0D\u77E5\u9053\u4ED6\u7684\u8EAB\u4EFD\u3002"
