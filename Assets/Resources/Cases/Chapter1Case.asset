  - Id: VN20
    Title: 
    Lines:
    - LeftArtKey: char/mp01_default
      RightArtKey: 
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u54C8\u7F57\u5FB7\u795E\u7236"
      Text: "\u8B66\u957F\uFF0C\u90A3\u5B69\u5B50\u9047\u5230\u4EC0\u4E48\u9EBB\u70E6\u4E86\u5417\uFF1F"
    - LeftArtKey: char/mp01_default
      RightArtKey: 
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u83AB\u91CC\u68EE"
      Text: "\u54C8\u7F57\u5FB7\u795E\u7236\uFF0C\u60A8\u4E0D\u7528\u62C5\u5FC3\uFF0C\u6211\u4EEC\u53EA\u662F\u6765\u5BFB\u627E\u7EBF\u7D22\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: 
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u54C8\u7F57\u5FB7\u795E\u7236"
      Text: "\u597D\uFF0C\u6211\u4F1A\u914D\u5408\u7684\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: 
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u83AB\u91CC\u68EE"
      Text: "\u795E\u7236\uFF0C\u8FD9\u4F4D\u5E74\u8F7B\u4EBA\uFF0C\u662F\u4EC0\u4E48\u65F6\u5019\u6765\u6559\u5802\u5DE5\u4F5C\u7684\u5462\uFF1F"
    - LeftArtKey: char/mp01_default
      RightArtKey: 
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u54C8\u7F57\u5FB7\u795E\u7236"
      Text: "\u6709\u4E00\u6BB5\u65F6\u95F4\u4E86\uFF0C\u5927\u6982\u534A\u5E74\u524D\uFF0C\u6211\u770B\u5230\u585E\u5FB7\u91CC\u514B\u5728\u51FA\u552E\u81EA\u5DF1\u7684\u753B\uFF0C\u4F46\u662F\u6CA1\u4EC0\u4E48\u4EBA\u5173\u6CE8\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: 
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u54C8\u7F57\u5FB7\u795E\u7236"
      Text: "\u540E\u6765\uFF0C\u5728\u6D4E\u8D2B\u9662\u53D1\u653E\u98DF\u7269\u65F6\uFF0C\u6211\u53C8\u770B\u5230\u4E86\u8FD9\u5B69\u5B50\uFF0C\u6211\u5C31\u9080\u8BF7\u4ED6\u6765\u4E3A\u6559\u5802\u4F5C\u753B\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: 
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u83AB\u91CC\u68EE"
      Text: "\u539F\u6765\u662F\u8FD9\u6837\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: 
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u54C8\u7F57\u5FB7\u795E\u7236"
      Text: "\u8FD9\u5B69\u5B50\u5F88\u6709\u7ED8\u753B\u5929\u8D4B\uFF0C\u8FD8\u6309\u65F6\u53C2\u4E0E\u65E9\u665A\u7977\uFF0C\u6700\u8FD1\u7684\u62A5\u7EB8\u4E0A\u7684\u6848\u5B50\uFF0C\u6211\u4E5F\u770B\u8FC7\uFF0C\u6211\u89C9\u5F97\u4E0D\u53EF\u80FD\u662F\u4ED6\u505A\u7684\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: 
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u83AB\u91CC\u68EE"
      Text: "\u795E\u7236\uFF0C\u5BFB\u627E\u8BC1\u636E\u662F\u6211\u4EEC\u8B66\u5BDF\u7684\u8D23\u4EFB\uFF0C\u60A8\u4E0D\u9700\u8981\u62C5\u5FC3\uFF0C\u6211\u4EEC\u4E0D\u4F1A\u51A4\u6789\u597D\u4EBA\u7684\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: 
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u83AB\u91CC\u68EE"
      Text: "\u585E\u5FB7\u91CC\u514B\u7684\u4F4F\u5904\u5728\u54EA\u91CC\uFF0C\u6211\u4EEC\u80FD\u67E5\u770B\u4E00\u4E0B\u5417\uFF1F"
    - LeftArtKey: char/mp01_default
      RightArtKey: 
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u65C1\u767D"
      Text: "\u54C8\u7F57\u5FB7\u795E\u7236\u5C06\u83AB\u91CC\u68EE\u5E26\u5230\u9601\u697C\uFF0C\u9601\u697C\u5806\u653E\u7684\u6742\u7269\u4E2D\uFF0C\u4E34\u8FD1\u7A97\u53E3\u7684\u5730\u65B9\uFF0C\u88AB\u6E05\u7406\u51FA\u4E86\u4E00\u7247\u533A\u57DF\uFF0C\u653E\u7740\u4E00\u5F20\u5E8A\uFF0C\u4E00\u4E2A\u77EE\u684C\uFF0C\u77EE\u684C\u4E0B\u9762\uFF0C\u653E\u7740\u4E00\u4E2A\u5305\u88B1\u3001\u4E00\u6876\u5DE5\u5177\u3002\u83AB\u91CC\u68EE\u56DE\u5934\uFF0C\u5411\u9601\u697C\u4E0B\u7684\u5176\u4ED6\u8B66\u5458\u793A\u610F\u8FC7\u6765\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: 
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u83AB\u91CC\u68EE"
      Text: "\u55EF\uFF0C\u6765\u4EBA\uFF0C\u628A\u8FD9\u91CC\u7684\u4E1C\u897F\u8BB0\u5F55\u4E00\u4E0B\u3002"
  - Id: VN21
    Title: 
    Lines:
    - LeftArtKey: char/mp02_default
      RightArtKey: 
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u96EA\u8389"
      Text: "\u795E\u7236\uFF0C\u6211\u662F\u83AB\u91CC\u68EE\u7684\u526F\u624B\uFF0C\u80FD\u95EE\u60A8\u4E00\u4E9B\u95EE\u9898\u5417\uFF1F"
    - LeftArtKey: char/mp02_default
      RightArtKey: 
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u54C8\u7F57\u5FB7\u795E\u7236"
      Text: "\u55EF\uFF0C\u8BF7\u60A8\u95EE\u5427\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: 
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u96EA\u8389"
      Text: "\u8FD9\u4F4D\u585E\u5FB7\u91CC\u514B\u5148\u751F\u662F\u60A8\u62DB\u52DF\u7684\uFF0C\u8FD8\u662F\u6559\u533A\u4E3B\u6559\u6307\u6D3E\u7684\uFF1F"
    - LeftArtKey: char/mp02_default
      RightArtKey: 
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u54C8\u7F57\u5FB7\u795E\u7236"
      Text: "\u55EF\uFF0C\u662F\u6211\u89C1\u4ED6\u9700\u8981\u5E2E\u52A9\uFF0C\u6559\u5802\u4E5F\u9700\u8981\u4E00\u4F4D\u7ED8\u5236\u5F69\u7ED8\u7684\u753B\u5E08\uFF0C\u6211\u4FBF\u62DB\u52DF\u4E86\u4ED6\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: 
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u96EA\u8389"
      Text: "\u539F\u6765\u5982\u6B64\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: 
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u54C8\u7F57\u5FB7\u795E\u7236"
      Text: "\u585E\u5FB7\u91CC\u514B\u4E4B\u524D\u7684\u753B\u6211\u4E5F\u770B\u8FC7\uFF0C\u4ED6\u753B\u5F97\u5F88\u4E0D\u9519\uFF0C\u4E5F\u9700\u8981\u4E00\u4EFD\u5DE5\u4F5C\u7EF4\u751F\uFF0C\u4ED6\u7EDD\u4E0D\u4F1A\u505A\u6740\u4EBA\u7684\u4E8B\u7684\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: 
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u96EA\u8389"
      Text: "\u6B7B\u8005\u548C\u51F6\u624B\u53D1\u751F\u8FC7\u640F\u6597\uFF0C\u51F6\u624B\u7684\u8863\u670D\u6050\u6015\u4F1A\u6CBE\u8840\uFF0C\u60A8\u6709\u89C1\u8FC7\u585E\u5FB7\u91CC\u514B\u7A7F\u8FC7\u5176\u4ED6\u7684\u8863\u7269\u5417\uFF1F"
    - LeftArtKey: char/mp02_default
      RightArtKey: 
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u54C8\u7F57\u5FB7\u795E\u7236"
      Text: "\u8FD9\uFF0C\u6CA1\u6709\uFF0C\u6CA1\u6709\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: 
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u96EA\u8389"
      Text: "\u60A8\u786E\u5B9A\u5417\uFF1F"
    - LeftArtKey: char/mp02_default
      RightArtKey: 
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u54C8\u7F57\u5FB7\u795E\u7236"
      Text: "\u786E\u5B9A\u3002"
