      Text: "\u55EF\uFF0C\u662F\u7684\uFF0C\u4ED6\u8FD9\u51E0\u5929\u591C\u91CC\uFF0C\u90FD\u5728\u753B\u8FD9\u5E45\u796D\u575B\u5F69\u7ED8\uFF0C\u8FD9\u4E5F\u662F\u6240\u6709\u753B\u4E2D\u7684\u91CD\u70B9\uFF0C\u9664\u4E86\u7ED8\u753B\uFF0C\u8FD8\u8981\u96D5\u523B\u548C\u9576\u5D4C\u51FA\u5723\u50CF\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: 
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u83AB\u91CC\u68EE"
      Text: "\u770B\u6765\u4ED6\u9664\u4E86\u7ED8\u753B\uFF0C\u8FD8\u5F88\u64C5\u957F\u96D5\u5851\u554A\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: 
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u96EA\u8389"
      Text: "\u8FD9\u91CC\u8FD9\u4E48\u591A\u7684\u753B\uFF0C\u7528\u5230\u7684\u7684\u989C\u6599\u90FD\u662F\u585E\u5FB7\u91CC\u514B\u81EA\u5DF1\u4E70\u7684\u5417\uFF1F\u5F97\u82B1\u4E0D\u5C11\u94B1\u5427\uFF1F"
    - LeftArtKey: char/mp02_default
