  - Id: story_stage3_start
    Title: "\u585E\u5FB7\u91CC\u514B\u88AB\u5E26\u8D70"
    Body: "\u83AB\u91CC\u68EE\uFF1A\u585E\u5FB7\u91CC\u514B\uFF0C\u8DDF\u6211\u4EEC\u53BB\u8B66\u5C40\u5427\u3002\n\u585E\u5FB7\u91CC\u514B\uFF1A\u4EC0\uFF0C\u4EC0\u4E48\uFF1F\u4E3A\u4EC0\u4E48\uFF01\n\u54C8\u7F57\u5FB7\u795E\u7236\uFF1A\u8B66\u957F\uFF0C\u6211\u80FD\u95EE\u95EE\u4E3A\u4EC0\u4E48\u5417\uFF1F\n\u83AB\u91CC\u68EE\uFF1A\u4ED6\u8FD9\u628A\u5200\uFF0C\u548C\u6B7B\u8005\u8EAB\u4E0A\u7684\u4F24\u53E3\u4E00\u81F4\u3002\n\u96EA\u8389\uFF1A\u795E\u7236\uFF0C\u4ED6\u53EA\u6709\u8FD9\u4E00\u5957\u8863\u670D\u5417\uFF1F\n\u795E\u7236\uFF1A\u662F\u7684\uFF0C\u662F\u7684\u3002\n\u96EA\u8389\uFF1A\u90A3\u600E\u4E48\u4F1A\u8FD9\u4E48\u5E72\u51C0\u5462\uFF1F"
    Presentation: 0
    SetFlagsOnPlay: []
  - Id: story_case_closed
    Title: "\u6848\u4EF6\u4E86\u7ED3"
    Body: "\u8840\u8863\u4E0A\u7684\u989C\u6599\u3001\u6559\u5802\u4E13\u5C5E\u7684\u767D\u3001\u548C\u90A3\u4EF6\u6C38\u8FDC\u53EA\u6709\u4E00\u4EF6\u7684\u5916\u5957\u3002\n\u585E\u5FB7\u91CC\u514B\u5728\u76D1\u7262\u91CC\u4E0D\u518D\u8BF4\u8BDD\u3002\n\n\u65AF\u5A01\u514B\u4E1C\u533A\u7684\u4E24\u6869\u591C\u8DEF\u547D\u6848\uFF0C\u7ED3\u4E86\u3002"
    Presentation: 0
    SetFlagsOnPlay: []
  scenes:
