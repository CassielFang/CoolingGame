      RightDimmed: 1
      Speaker: "\u83AB\u91CC\u68EE"
      Text: "\u6211\u518D\u95EE\u4F60\u4E00\u904D\uFF01\u4E5D\u6708\u56DB\u65E5\uFF0C\u4E5D\u6708\u5341\u4E03\u65E5\uFF0C\u4F60\u5E72\u4E86\u4EC0\u4E48\uFF01\u4F60\u628A\u67D3\u8840\u7684\u8863\u670D\u85CF\u5230\u54EA\u91CC\u4E86\uFF01\u8FD8\u6709\u90A3\u628A\u88C1\u5E03\u7684\u5200\uFF0C\u662F\u4E0D\u662F\u51F6\u5668\uFF01"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u585E\u5FB7\u91CC\u514B"
      Text: "\u90A3\u628A\u5200\u5F88\u5BB9\u6613\u4E70\u5230\u7684\uFF0C\u6211\u6CA1\u6709\u6740\u4EBA\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u585E\u5FB7\u91CC\u514B"
      Text: "\u5982\u679C\u4F60\u4EEC\u627E\u4E0D\u5230\u51F6\u624B\uFF0C\u5C31\u628A\u7F6A\u540D\u5B89\u5728\u6211\u8FD9\u6837\u65E0\u4F9D\u65E0\u9760\u7684\u4EBA\u8EAB\u4E0A\uFF0C\u6211\u4E5F\u4EC0\u4E48\u529E\u6CD5\u90FD\u6CA1\u6709\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u585E\u5FB7\u91CC\u514B"
      Text: "\u4E0A\u5E1D\u554A\uFF0C\u6C42\u4F60\u5728\u4E0D\u4EC1\u4E0D\u4E49\u7684\u767E\u59D3\u4E2D\uFF0C\u4E3A\u6211\u4F38\u51A4\uFF0C\u62EF\u6551\u6211\u8131\u79BB\u5978\u8BC8\u90AA\u6076\u7684\u4EBA\u2026\u2026"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u65C1\u767D"
      Text: "\u585E\u5FB7\u91CC\u514B\u51E0\u4E4E\u5FEB\u54ED\u4E86\u51FA\u6765\uFF0C\u53CC\u624B\u5408\u5341\uFF0C\u5F00\u59CB\u5FF5\u8D77\u7977\u6587\uFF0C\u83AB\u91CC\u68EE\u65E0\u53EF\u5948\u4F55\uFF0C\u6C14\u6124\u7684\u8D77\u8EAB\u51FA\u4E86\u95E8\uFF0C\u5C06\u585E\u5FB7\u91CC\u514B\u4E00\u4EBA\u7559\u5728\u5BA1\u8BAF\u5BA4\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u96EA\u8389"
      Text: "\u770B\u6765\u4E0D\u7BA1\u7528\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u83AB\u91CC\u68EE"
      Text: "\u6211\u4EEC\u7F3A\u5C11\u76F4\u63A5\u7684\u8BC1\u636E\uFF0C\u4F60\u7684\u63A8\u7406\u53EA\u80FD\u8BC1\u660E\u4ED6\u6709\u6740\u4EBA\u6761\u4EF6\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u96EA\u8389"
      Text: "\u80AF\u5B9A\u6709\u4EC0\u4E48\u6211\u4EEC\u9057\u6F0F\u7684\u4E1C\u897F\uFF0C\u6211\u4EEC\u6700\u597D\u91CD\u65B0\u68C0\u67E5\u4E00\u4E0B\u6848\u4EF6\u6863\u6848\u3002"
  - Id: VN24
    Title: 
    Lines:
    - LeftArtKey: 
      RightArtKey: 
      LeftDimmed: 0
      RightDimmed: 0
      Speaker: "\u65C1\u767D"
      Text: "\u4E24\u4EBA\u5C06\u6848\u4EF6\u6863\u6848\u7684\u5168\u90E8\u6587\u4EF6\u653E\u5728\u684C\u4E0A\uFF0C\u53C8\u63A8\u6765\u4E86\u8D34\u6EE1\u7EBF\u7D22\u548C\u7B14\u8BB0\u7684\u6848\u4EF6\u677F\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u83AB\u91CC\u68EE"
      Text: "\u585E\u5FB7\u91CC\u514B\u7684\u8EAB\u5F62\u548C\u6211\u6839\u636E\u811A\u5370\u7684\u63A8\u6D4B\u57FA\u672C\u543B\u5408\uFF0C\u978B\u5E95\u4E5F\u7B26\u5408\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u96EA\u8389"
      Text: "\u4F46\u662F\u76F8\u540C\u7684\u978B\u5E95\u592A\u591A\u4E86\uFF0C\u6CD5\u5EAD\u4E0A\u6CA1\u6CD5\u4F5C\u4E3A\u6709\u529B\u7684\u6307\u63A7\u3002\u51F6\u5668\u5462\uFF1F"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u83AB\u91CC\u68EE"
      Text: "\u4ECE\u6B7B\u8005\u7684\u521B\u53E3\u770B\uFF0C\u51F6\u5668\u786E\u5B9E\u662F\u4E00\u628A\u7EC6\u957F\u7684\u5200\uFF0C\u4F46\u585E\u5FB7\u91CC\u514B\u7684\u5200\u4E0A\u6CBE\u4E86\u5404\u79CD\u989C\u6599\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u96EA\u8389"
      Text: "\u5BF9\uFF0C\u5C31\u7B97\u662F\u5200\u4E0A\u6CBE\u4E86\u8840\uFF0C\u4ED6\u4E5F\u5B8C\u5168\u6765\u5F97\u53CA\u6E05\u6D17\u6389\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u83AB\u91CC\u68EE"
      Text: "\u8BF6\uFF1F\u5C38\u4F53\u7167\u7247\u624B\u4E0A\u8FD9\u662F\u4EC0\u4E48\uFF1F"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u83AB\u91CC\u68EE"
      Text: "\u8FD9\u4E2A\u554A\uFF0C\u8FD9\u5E94\u8BE5\u662F\u79C1\u4EBA\u4FF1\u4E50\u90E8\u821E\u5973\u8138\u4E0A\u7684\u5316\u5986\u54C1\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u96EA\u8389"
      Text: "\u8FD9\u4E2A\u767D\u8272\uFF0C\u597D\u50CF\u6709\u70B9\u773C\u719F\uFF0C\u548C\u5316\u5986\u54C1\u7684\u767D\u8272\u4E0D\u592A\u4E00\u6837\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u83AB\u91CC\u68EE"
      Text: "\u767D\u8272\u5C31\u662F\u767D\u8272\u561B\uFF0C\u80FD\u6709\u4EC0\u4E48\u533A\u522B\uFF1F"
  - Id: VN25
    Title: 
    Lines:
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u96EA\u8389"
      Text: "\u5C31\u662F\u8FD9\u4E2A\uFF01\u8FD9\u662F\u6559\u5802\u4E13\u7528\u7684\u767D\u8272\u989C\u6599\uFF01"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u83AB\u91CC\u68EE"
      Text: "\u5982\u679C\u6B7B\u8005\u8EAB\u4E0A\u6CBE\u4E86\u6559\u5802\u7684\u989C\u6599\uFF0C\u4ED6\u5C31\u7EDD\u5BF9\u8DD1\u4E0D\u4E86\u4E86\uFF01"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u83AB\u91CC\u68EE"
      Text: "\u6211\u73B0\u5728\u53BB\u6559\u5802\u91C7\u96C6\u8BC1\u7269\uFF0C\u4F60\u53BB\u548C\u5165\u6B93\u5E08\u8BF4\uFF0C\u8BA9\u4ED6\u91C7\u96C6\u6B7B\u8005\u624B\u4E0A\u7684\u989C\u6599\u3002"
    - LeftArtKey: 
      RightArtKey: char/mp02_default
      LeftDimmed: 0
      RightDimmed: 0
      Speaker: "\u65C1\u767D"
      Text: "\u753B\u672A\u8BF4\u5B8C\uFF0C\u83AB\u91CC\u68EE\u4FBF\u51B2\u51FA\u4E86\u529E\u516C\u5BA4\uFF0C\u96EA\u8389\u6697\u81EA\u611F\u53F9\u8B66\u957F\u7684\u96F7\u5389\u98CE\u884C\uFF0C\u62E8\u7535\u8BDD\u7ED9\u4E86\u6B93\u5C38\u623F\u3002"
    - LeftArtKey: 
      RightArtKey: 
      LeftDimmed: 0
      RightDimmed: 0
      Speaker: 
      Text: "\u4E0D\u4E45\u4E4B\u540E\uFF0C\u83AB\u91CC\u68EE\u548C\u624B\u4E0B\u7684\u8B66\u5458\u4FBF\u62FF\u7740\u8BC1\u7269\u56DE\u5230\u4E86\u8B66\u5C40\uFF0C\u4F46\u8DDF\u7740\u4E00\u8D77\u56DE\u6765\u7684\uFF0C\u8FD8\u6709\u54C8\u7F57\u5FB7\u795E\u7236\u3002"
