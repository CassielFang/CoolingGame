      Text: "\u585E\u5FB7\u91CC\u514B\u628A\u5934\u504F\u5230\u4E86\u4E00\u8FB9\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 0
      RightDimmed: 1
