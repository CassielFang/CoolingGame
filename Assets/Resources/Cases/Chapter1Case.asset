      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u96EA\u8389"
      Text: "\u4F60\u2026\u2026\u4F60\u53EA\u6709\u8FD9\u4E00\u5957\u8863\u670D\u5417\uFF1F"
