      Text: "\u4F60\u4EE5\u4E3A\u6211\u5F88\u611A\u8822\u5417\uFF1F"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 1
      RightDimmed: 1
      Speaker: "\u65C1\u767D"
      Text: "\u83AB\u91CC\u68EE\u6C89\u9ED8\u7684\u548C\u96EA\u8389\u5BF9\u89C6\uFF0C\u773C\u4E2D\u95EA\u7740\u6CEA\u5149\uFF0C\u96EA\u8389\u8FD9\u624D\u610F\u8BC6\u5230\uFF0C\u795E\u7236\u5728\u4ED6\u7684\u5FC3\u4E2D\u626E\u6F14\u7740\u591A\u4E48\u91CD\u8981\u7684\u89D2\u8272\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u96EA\u8389"
      Text: "\u4F60\u5982\u679C\u60F3\u77E5\u9053\u795E\u7236\u8FD9\u4E48\u505A\u7684\u539F\u56E0\uFF0C\u53EA\u6709\u4E00\u4E2A\u529E\u6CD5\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u65C1\u767D"
      Text: "\u83AB\u91CC\u68EE\u542C\u61C2\u4E86\u96EA\u8389\u7684\u610F\u601D\uFF0C\u53EB\u6765\u4E86\u5176\u4ED6\u8B66\u5458\uFF0C\u8BA9\u4ED6\u4EEC\u7167\u987E\u54C8\u7F57\u5FB7\u795E\u7236\uFF0C\u7AD9\u8D77\u8EAB\u6765\u548C\u96EA\u8389\u51FA\u4E86\u95E8\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u585E\u5FB7\u91CC\u514B"
      Text: "\u4F60\u4EEC\u600E\u4E48\u95EE\u4E5F\u6CA1\u7528\uFF0C\u6211\u6CA1\u6709\u6740\u4EBA\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u83AB\u91CC\u68EE"
      Text: "\u4F60\u6700\u597D\u8001\u5B9E\u70B9\uFF0C\u8FD9\u91CC\u6CA1\u6709\u522B\u4EBA\u4F1A\u6765\u3002"
    - LeftArtKey: 
      RightArtKey: 
      LeftDimmed: 0
      RightDimmed: 0
      Speaker: "\u65C1\u767D"
      Text: "\u624D\u521A\u5750\u597D\u7684\u83AB\u91CC\u68EE\uFF0C\u53C8\u8D77\u8EAB\u7AD9\u4E86\u8D77\u6765\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 1
      RightDimmed: 0
