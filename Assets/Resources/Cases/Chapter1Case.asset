      Text: "\u8BA9\u4ED6\u8BA4\u7F6A\uFF01"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u96EA\u8389"
      Text: "\u4E0D\u8981\u8FD9\u4E48\u51B2\u52A8\uFF0C\u5C31\u7B97\u903C\u4ED6\u8BA4\u7F6A\u4ED6\u4E5F\u53EF\u5728\u6CD5\u5EAD\u4E0A\u7FFB\u4F9B\uFF01"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u83AB\u91CC\u68EE"
      Text: "\u2026\u2026\u585E\u5FB7\u91CC\u514B\uFF0C\u4F60\u4E0D\u8981\u4EE5\u4E3A\u5634\u786C\u5C31\u6709\u7528\uFF0C\u6211\u4EEC\u5DF2\u7ECF\u627E\u5230\u4E86\u8BC1\u636E\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u585E\u5FB7\u91CC\u514B"
      Text: "\u6211\u6CA1\u6709\u6740\u4EBA\uFF0C\u4F60\u600E\u4E48\u683D\u8D43\u6211\u90FD\u884C\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u65C1\u767D"
      Text: "\u83AB\u91CC\u68EE\u60C5\u7EEA\u53C8\u8981\u88AB\u585E\u5FB7\u91CC\u514B\u6FC0\u4E86\u8D77\u6765\uFF0C\u96EA\u8389\u7ACB\u523B\u4F38\u624B\uFF0C\u62E6\u5728\u4E86\u4ED6\u7684\u624B\u81C2\u4E0A\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u96EA\u8389"
      Text: "\u6211\u4EEC\u662F\u4E0D\u4F1A\u8BEC\u9677\u4E00\u4E2A\u597D\u4EBA\u7684\uFF0C\u5982\u679C\u4F60\u771F\u7684\u65E0\u8F9C\uFF0C\u5C31\u4E00\u5B9A\u6709\u88AB\u653E\u8D70\u7684\u90A3\u4E00\u5929\uFF0C\u5BF9\u5427\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 1
      RightDimmed: 1
      Speaker: "\u65C1\u767D"
      Text: "\u585E\u5FB7\u91CC\u514B\u4F4E\u5782\u7740\u773C\uFF0C\u6CA1\u6709\u4EFB\u4F55\u53CD\u5E94\uFF0C\u4EFF\u4F5B\u4EC0\u4E48\u90FD\u6CA1\u542C\u89C1\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u96EA\u8389"
      Text: "\u4F46\u6211\u4EEC\u653E\u4E86\u4F60\uFF0C\u6CA1\u6709\u65B0\u7684\u51F6\u624B\uFF0C\u5A92\u4F53\u4E5F\u4F1A\u8BA4\u4E3A\u4F60\u662F\u51F6\u624B\u5427\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u96EA\u8389"
      Text: "\u90A3\u4E9B\u8BB0\u8005\uFF0C\u4EFF\u4F5B\u65E0\u5B54\u4E0D\u5165\uFF0C\u4ED6\u4EEC\u4E00\u5B9A\u4F1A\u4E0D\u505C\u7684\u95EE\u4F60\uFF0C\u65E0\u8BBA\u4F60\u600E\u4E48\u62D2\u7EDD\uFF0C\u90A3\u4E9B\u76EE\u5149\u4E5F\u4E0D\u4F1A\u4ECE\u4F60\u7684\u8EAB\u4E0A\u79FB\u5F00\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u96EA\u8389"
      Text: "\u5F88\u5FEB\uFF0C\u4ED6\u4EEC\u5C31\u4F1A\u53D1\u73B0\uFF0C\u8FD9\u4E2A\u9690\u85CF\u5728\u6DF1\u591C\u5DF7\u9053\u91CC\u7684\u6740\u4EBA\u51F6\u624B\uFF0C\u8FD8\u662F\u4E00\u4E2A\u827A\u672F\u5BB6\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u96EA\u8389"
      Text: "\u4F60\u5728\u6559\u5802\u4E2D\u7684\u753B\u4F1A\u88AB\u62A5\u9053\uFF0C\u4F60\u66FE\u7ECF\u753B\u51FA\u7684\u4F5C\u54C1\u4F1A\u88AB\u53D1\u73B0\uFF0C\u90A3\u4E9B\u827A\u672F\u8BC4\u8BBA\u5BB6\u5C06\u4ECE\u4F60\u7684\u753B\u4E2D\u89E3\u8BFB\u51FA\u66F4\u591A\u4E0D\u4E00\u6837\u7684\u4E1C\u897F\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: char/mp01_default
