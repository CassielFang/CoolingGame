      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u54C8\u7F57\u5FB7\u795E\u7236"
      Text: "\u8FD9\u5012\u4E0D\u662F\uFF0C\u6559\u5802\u753B\u7528\u5230\u7684\u989C\u6599\u662F\u6559\u4F1A\u4E13\u5C5E\u7684\u3002"
