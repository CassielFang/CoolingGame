      Text: "\u96EA\u8389\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u83AB\u91CC\u68EE"
      Text: "\u96EA\u8389\u5C0F\u59D0\uFF0C\u529E\u6848\u4E0D\u662F\u5199\u5C0F\u8BF4\uFF0C\u6211\u4F1A\u548C\u4E0A\u7EA7\u62A5\u544A\uFF0C\u4F60\u4E0D\u9002\u5408\u5728\u8FD9\u91CC\u5DE5\u4F5C\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u96EA\u8389"
      Text: "\u5148\u751F\uFF0C\u6211\u8BA4\u4E3A\u6211\u6BD4\u60A8\u66F4\u9002\u5408\u62C5\u4EFB\u8FD9\u4EFD\u5DE5\u4F5C\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u83AB\u91CC\u68EE"
      Text: "\u4F60\u4E5F\u592A\u65E0\u793C\u4E86\uFF0C\u5C0F\u59D0\uFF01"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u96EA\u8389"
      Text: "\u65E0\u653F\u5E9C\u4E3B\u4E49\u8005\u4EEC\u662F\u6709\u653F\u6CBB\u8BC9\u6C42\u7684\u4EBA\uFF0C\u4ED6\u4EEC\u66F4\u613F\u610F\u81EA\u5DF1\u7684\u884C\u5F84\u88AB\u4EBA\u53D1\u73B0\uFF0C\u4E0D\u662F\u5417?\u4ED6\u4EEC\u4E0D\u4F1A\u6740\u6389\u4E00\u4E2A\u65E0\u5173\u7D27\u8981\u7684\u5E97\u4E3B\uFF0C\u4E5F\u4E0D\u4F1A\u8D39\u5C3D\u5FC3\u601D\u9690\u7792\u884C\u8E2A\u3002\u60A8\u7684\u63A8\u6D4B\u5E76\u4E0D\u7B26\u5408\u73B0\u5B9E\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u83AB\u91CC\u68EE"
      Text: "\u60A8\u8FD9\u4F4D\u517B\u5C0A\u5904\u4F18\u7684\u5C0F\u59D0\uFF0C\u600E\u4E48\u80FD\u77E5\u9053\u8FD9\u4E9B\u4E8B\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u96EA\u8389"
      Text: "\u6211\u4ECE\u5965\u5730\u5229\u6765\uFF0C\u90A3\u8FB9\u7684\u65E0\u653F\u5E9C\u4E3B\u4E49\u8005\u591A\u7684\u80FD\u518D\u5EFA\u4E00\u4E2A\u8FD9\u6837\u7684\u8B66\u5C40\u4E86\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u83AB\u91CC\u68EE"
      Text: "\u4F60\u662F\u5728\u8BF4\u6211\u4EEC\u4E5F\u662F\u4E4C\u5408\u4E4B\u4F17\u5417\uFF01"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u96EA\u8389"
      Text: "\u51F6\u624B\u7528\u5200\u53CD\u590D\u6345\u5411\u53D7\u5BB3\u4EBA\uFF0C\u8FD9\u662F\u4E00\u79CD\u53D1\u6CC4\uFF0C\u4ED6\u4E00\u5B9A\u6709\u4E00\u79CD\u88AB\u538B\u6291\u7684\u5FC3\u7406\uFF0C\u4EC7\u6068\u4E0E\u53D7\u5BB3\u8005\u76F8\u4F3C\u7684\u4EBA\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u96EA\u8389"
      Text: "\u51F6\u624B\u5F88\u53EF\u80FD\u4F5C\u606F\u663C\u591C\u98A0\u5012\uFF0C\u800C\u4E14\u5916\u8868\u4E0D\u4F1A\u662F\u51F6\u6076\u4E4B\u4EBA\uFF0C\u751A\u81F3\u53EF\u80FD\u6709\u4E9B\u6587\u5F31\u3002\u751F\u6D3B\u6761\u4EF6\u4E00\u822C\u751A\u81F3\u8D2B\u56F0\uFF0C\u4F46\u80FD\u4E0E\u5BCC\u4EBA\u63A5\u89E6\uFF0C\u4F60\u4EEC\u5E94\u8BE5\u4ECE\u57CE\u91CC\u4EBA\u627E\u8D77\uFF0C\u5C24\u5176\u662F\u591C\u73ED\u5DE5\u4EBA\u8FD9\u6837\u7684\u804C\u4E1A\uFF0C\u800C\u4E0D\u662F\u5916\u56FD\u4EBA\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u96EA\u8389"
      Text: "\u53E6\u5916\uFF0C\u8FD8\u8981\u6392\u67E5\u6D4E\u8D2B\u9662\u3001\u6559\u5802\u8FD9\u6837\u7684\u573A\u6240\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 1
      RightDimmed: 1
      Speaker: "\u65C1\u767D"
      Text: "\u96EA\u8389\u6D41\u7545\u7684\u63A8\u7406\u4F7F\u83AB\u91CC\u68EE\u8B66\u957F\u611F\u5230\u60CA\u8BB6\uFF0C\u4ED6\u60F3\u8981\u53CD\u9A73\u4EC0\u4E48\uFF0C\u4F46\u60F3\u5230\u81EA\u5DF1\u4E00\u4E2A\u6708\u6765\u7684\u4E00\u65E0\u6240\u83B7\uFF0C\u5FAE\u5F20\u7740\u7684\u5634\u5DF4\uFF0C\u5C31\u53D1\u4E0D\u51FA\u4EFB\u4F55\u58F0\u97F3\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 1
      RightDimmed: 1
      Speaker: "\u65C1\u767D"
      Text: "\u5C34\u5C2C\u7684\u83AB\u91CC\u68EE\u618B\u4E86\u534A\u5929\uFF0C\u53EA\u80FD\u770B\u5411\u8B66\u5C40\u91CC\u7684\u5176\u4ED6\u4EBA\u3002"
