  detectives:
  - Id: MP01
    DisplayName: "\u83AB\u91CC\u68EE\u8B66\u957F"
    PortraitArtKey: char/mp01_default
    PortraitSmileKey: char/mp01_smile
    PortraitQuestionKey: char/mp01_question
    Description: "\u4E1C\u533A\u8B66\u5C40\u8B66\u957F\u3002\u5F3A\u786C\u3001\u52A1\u5B9E\u3001\u6709\u70B9\u6025\u8E81\uFF1B\u64C5\u957F\u73B0\u573A\u548C\u5BA1\u8BAF\u3002"
  - Id: MP02
    DisplayName: "\u96EA\u8389"
    PortraitArtKey: char/mp02_default
    PortraitSmileKey: char/mp02_smile
    PortraitQuestionKey: char/mp02_question
    Description: "\u5199\u5C0F\u8BF4\u7684\u5916\u884C\u4EBA\u3002\u89C2\u5BDF\u7EC6\u3001\u64C5\u957F\u6BD4\u5BF9\u6587\u5B57\u4E0E\u8BC1\u8BCD\uFF1B\u8001\u8B66\u957F\u63A8\u8350\u5979\u6765\u534F\u52A9\u3002"
  startingDetectiveId: MP01
  startingCardIds: []
  newspapers:
  - Id: N01
    Title: "\u300A\u65AF\u5A01\u514B\u7684\u8FDE\u73AF\u6740\u624B\u300B"
    Body: "\u65AF\u5A01\u514B\u90AE\u62A5 1895\u5E7410\u67084\u65E5 \u5934\u7248\n\u7816\u74E6\u5DF7\u7684\u8FDE\u73AF\u51F6\u6848\n\u7816\u74E6\u5DF7\u7684\u8FDE\u73AF\u51F6\u6740\u6848\u53D1\u751F\u5DF2\u6709\u6708\u4F59\uFF0C\u65AF\u5A01\u514B\u57CE\u5DF2\u662F\u4EBA\u5FC3\u60F6\u60F6\u3002\n\u4E00\u4E2A\u6708\u524D\uFF0C\u4E00\u540D\u73E0\u5B9D\u5E97\u5E97\u4E3B\u88AB\u6740\u6B7B\u5728\u7816\u74E6\u5DF7\uFF0C\u4E24\u5468\u524D\uFF0C\u8BAE\u5458\u5361\u6797\u987F\u4E4B\u5B50\u4E5F\u6B7B\u5728\u4E86\u4E34\u8FD1\u7684\u5730\u65B9\uFF0C\u6B7B\u72B6\u51C4\u60E8\uFF0C\u4F7F\u4EBA\u76EE\u4E0D\u5FCD\u89C6\u3002\n\u636E\u8BB0\u8005\u8C03\u67E5\u2026\u2026\n\u2026\u2026\u6211\u4EEC\u539F\u672C\u4EE5\u4E3A\uFF0C\u5728\u8FD9\u5EA7\u4E16\u754C\u7EA7\u5DE5\u4E1A\u57CE\u5E02\u4E2D\uFF0C\u6211\u4EEC\u5904\u4E8E\u8B66\u961F\u7684\u4FDD\u62A4\u4E2D\uFF0C\u53EF\u5982\u4ECA\u8FDE\u8BAE\u5458\u7684\u513F\u5B50\u90FD\u88AB\u4EBA\u6740\u5BB3\uFF0C\u51F6\u624B\u4ECD\u7136\u5728\u9003\uFF0C\u8B66\u961F\u8FDF\u8FDF\u6CA1\u6709\u6293\u5230\u51F6\u72AF\u3002\n\u83AB\u91CC\u68EE\u8B66\u957F\u5411\u672C\u62A5\u8BB0\u8005\u8868\u793A\u2026\u2026\n\u2026\u2026\u7136\u800C\u5728\u672C\u62A5\u8BB0\u8005\u5411\u8B66\u957F\u95EE\u51FA\u4EC0\u4E48\u65F6\u5019\u80FD\u6293\u5230\u7F6A\u72AF\u65F6\uFF0C\u8B66\u957F\u7ADF\u7136\u65E0\u8A00\u4EE5\u5BF9\u3002\u6211\u4EEC\u4E0D\u7981\u8981\u5411\u8B66\u957F\u53D1\u95EE\uFF0C\u6211\u4EEC\u8FD8\u5B89\u5168\u5417\uFF1F\u65AF\u5A01\u514B\u8FD8\u5B89\u5168\u5417\uFF1F\n\u8BF7\u5404\u4F4D\u5E02\u6C11\u7EE7\u7EED\u5173\u6CE8\u65AF\u5A01\u514B\u90AE\u62A5\uFF0C\u5728\u8FD9\u4E2A\u5371\u9669\u7684\u65F6\u4EE3\uFF0C\u65B0\u95FB\u5C31\u662F\u5B89\u5168\u7684\u98CE\u5411\u6807\uFF01"
  - Id: N02
    Title: "\u300A\u201C\u5965\u59C6\u62C9\u8FEA\u7EB3\u201D\u5DF2\u7ECF\u8FDB\u5165\u82F1\u56FD\u300B"
    Body: "\u65AF\u5A01\u514B\u90AE\u62A5 1895\u5E7410\u67085\u65E5 \u5934\u7248\n\u201C\u5965\u59C6\u62C9\u8FEA\u7EB3\u201D\u5728\u6211\u4EEC\u8EAB\u8FB9\uFF01\n\u81EA1893\u5E74\u4EE5\u6765\uFF0C\u201C\u5965\u59C6\u62C9\u8FEA\u7EB3\u201D\u5728\u6377\u514B\u9634\u8C0B\u5236\u9020\u4E86\u4E00\u7CFB\u5217\u6697\u6740\u548C\u7206\u70B8\u9634\u8C0B\uFF0C\u610F\u56FE\u64BC\u52A8\u5E1D\u56FD\u7684\u7EDF\u6CBB\u2026\u2026\n\u2026\u2026\u5965\u5730\u5229\u7687\u5BB6\u5BAA\u5175\u5DF2\u7ECF\u902E\u6355\u8D77\u8BC9\u4E86\u51E0\u5341\u540D\u9752\u5E74\uFF0C\u4ECD\u6709\u8BB8\u591A\u6F5C\u5728\u7684\u7F6A\u72AF\u5728\u9003\u2026\u2026\n\u2026\u2026\u53BB\u5E74\u6CD5\u56FD\u9881\u5E03\u4E86\u4E09\u6761\u201C\u7279\u522B\u6CD5\u4EE4\u201D\uFF0C\u65E0\u653F\u5E9C\u4E3B\u4E49\u7F6A\u72AF\u4EE5\u66F4\u591A\u7684\u66B4\u529B\u624B\u6BB5\u56DE\u5E94\uFF0C\u7B56\u5212\u4E86\u53BB\u5E74\u516D\u6708\u5728\u91CC\u6602\u9488\u5BF9\u6CD5\u5170\u897F\u603B\u7EDF\u7684\u523A\u6740\u3002\n\u5982\u4ECA\u6B27\u6D32\u5927\u9646\u7684\u60C5\u52BF\u4E00\u65E5\u4E25\u8FC7\u4E00\u65E5\uFF0C\u5404\u56FD\u519B\u8B66\u5747\u5DF2\u9488\u5BF9\u65E0\u653F\u5E9C\u4E3B\u4E49\u7F6A\u72AF\u5C55\u5F00\u884C\u52A8\u2026\u2026\n\u2026\u2026\u636E\u4F26\u6566\u8B66\u65B9\u6D88\u606F\uFF0C\u8FD9\u4E9B\u7F6A\u72AF\u6B63\u4E58\u5750\u706B\u8F66\u548C\u8F6E\u8239\uFF0C\u4E00\u8DEF\u5411\u897F\uFF0C\u610F\u5728\u6E17\u900F\u5165\u6211\u4EEC\u5F3A\u5927\u7684\u5E1D\u56FD\uFF0C\u751A\u81F3\u4E8E\u6F5C\u5165\u6211\u4EEC\u751F\u6D3B\u7684\u65AF\u5A01\u514B\u2026\u2026\n\u2026\u2026\u201C\u4E0E\u8FD9\u4E9B\u65E0\u653F\u5E9C\u4E3B\u4E49\u7F6A\u72AF\u751F\u6D3B\u5728\u540C\u4E00\u57CE\u5E02\uFF0C\u6211\u4EEC\u5BB3\u6015\u6781\u4E86\u201D\uFF0C\u53D7\u91C7\u8BBF\u7684\u5E02\u6C11\u5982\u6B64\u8BF4\u9053\u3002\n\u8BF7\u5404\u4F4D\u5E02\u6C11\u7EE7\u7EED\u5173\u6CE8\u65AF\u5A01\u514B\u90AE\u62A5\uFF0C\u5728\u8FD9\u4E2A\u5371\u9669\u7684\u65F6\u4EE3\uFF0C\u65B0\u95FB\u5C31\u662F\u5B89\u5168\u7684\u98CE\u5411\u6807\uFF01"
  - Id: N03
    Title: "\u300A\u8FDE\u73AF\u6740\u624B\u843D\u7F51\u300B"
    Body: "\u65AF\u5A01\u514B\u90AE\u62A5 1895\u5E7411\u670812\u65E5\n\u8B66\u961F\u7834\u6848\uFF1F\u8FD8\u662F\u518D\u6B21\u5F92\u52B3\uFF1F\n\u672C\u62A5\u8BB0\u8005\u8BAF\uFF0C\u65AF\u5A01\u514B\u8B66\u961F\u4ECA\u65E5\u51FA\u8B66\u540E\uFF0C\u5C06\u4E00\u540D\u5ACC\u7591\u4EBA\u62BC\u9001\u56DE\u8B66\u5C40\uFF0C\u636E\u4F20\u95FB\uFF0C\u5ACC\u7591\u4EBA\u662F\u672C\u5730\u6559\u5802\u7684\u753B\u5E08\uFF0C\u7537\u2026\u2026\n\u2026\u2026\u201C\u7816\u74E6\u5DF7\u6740\u4EBA\u9B54\u201D\u7684\u6050\u614C\u5DF2\u7ECF\u4F20\u64AD\u4E86\u4E24\u4E2A\u6708\uFF0C\u8B66\u5C40\u7684\u6B64\u6B21\u884C\u52A8\u7EC8\u4E8E\u6709\u6240\u6536\u83B7\u2026\u2026\n\u2026\u2026\u6B7B\u8005\u5BB6\u5C5E\uFF0C\u5361\u6797\u987F\u8BAE\u5458\u7684\u592B\u4EBA\u5728\u91C7\u8BBF\u4E2D\u8868\u793A\uFF0C\u5C06\u4F1A\u5BC6\u5207\u5173\u6CE8\u8B66\u65B9\u7684\u7ED3\u679C\uFF0C\u5E0C\u671B\u8B66\u65B9\u627E\u5230\u771F\u6B63\u7684\u7F6A\u72AF\uFF0C\u8BA9\u6B7B\u8005\u80FD\u591F\u5F97\u5230\u5B89\u606F\u2026\u2026\n\u2026\u2026\u5982\u679C\u8FDE\u6559\u5802\u8FD9\u6837\u7684\u795E\u4F51\u4E4B\u5730\u90FD\u4F1A\u51FA\u73B0\u6740\u4EBA\u7F6A\u72AF\uFF0C\u90A3\u8FD8\u6709\u54EA\u91CC\u662F\u5B89\u5168\u7684\u5462\uFF1F\n\u8BF7\u5404\u4F4D\u5E02\u6C11\u7EE7\u7EED\u5173\u6CE8\u65AF\u5A01\u514B\u90AE\u62A5\uFF0C\u5728\u8FD9\u4E2A\u5371\u9669\u7684\u65F6\u4EE3\uFF0C\u65B0\u95FB\u5C31\u662F\u5B89\u5168\u7684\u98CE\u5411\u6807\uFF01"
  dialogues:
  - Id: VN01
    Title: 
    Lines:
    - LeftArtKey: char/mp01_default
      RightArtKey: 
      LeftDimmed: 0
      RightDimmed: 0
      Speaker: "\u83AB\u91CC\u68EE"
      Text: "\u90FD\u4E00\u4E2A\u6708\u4E86\uFF0C\u600E\u4E48\u8FD8\u627E\u4E0D\u5230\u51F6\u624B\uFF01"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/p08_officer
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u8B66\u5458"
      Text: "\u2026\u2026"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/p08_officer
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u83AB\u91CC\u68EE"
      Text: "\u4E0A\u7EA7\u53C8\u5728\u8B66\u544A\u6211\u4E86\uFF0C\u518D\u6293\u4E0D\u5230\u72AF\u4EBA\uFF0C\u5168\u8B66\u961F\u90FD\u8981\u5012\u9709\uFF01"
    - LeftArtKey: 
      RightArtKey: 
      LeftDimmed: 0
      RightDimmed: 0
      Speaker: "\u65C1\u767D"
      Text: "\u5728\u83AB\u91CC\u68EE\u8B66\u957F\u7684\u8BAD\u65A5\u4E0B\uFF0C\u8B66\u5C40\u7ACB\u523B\u53C8\u5FD9\u788C\u4E86\u8D77\u6765\uFF0C\u4EE5\u81F3\u4E8E\u4E00\u4E2A\u964C\u751F\u7684\u5973\u4EBA\uFF0C\u5F84\u76F4\u8D70\u5230\u4E86\u83AB\u91CC\u68EE\u684C\u524D\u624D\u88AB\u4EBA\u53D1\u73B0\u3002"
    - LeftArtKey: char/p08_officer
      RightArtKey: char/mp02_default
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u8B66\u5458"
      Text: "\u5973\u58EB\uFF0C\u8FD9\u91CC\u662FCID\uFF0C\u5982\u679C\u8981\u62A5\u6848\u8BF7\u53BB\u2026\u2026"
    - LeftArtKey: char/p08_officer
      RightArtKey: char/mp02_default
      LeftDimmed: 0
      RightDimmed: 0
      Speaker: "\u96EA\u8389"
      Text: "\u6211\u627E\u83AB\u91CC\u68EE\u8B66\u957F\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u83AB\u91CC\u68EE"
      Text: "\u6211\u5C31\u662F\uFF0C\u4F60\u6709\u4EC0\u4E48\u4E8B\uFF1F"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u96EA\u8389"
      Text: "\u6211\u662F\u4EA8\u5229\u5148\u751F\u7684\u670B\u53CB\uFF0C\u8FD9\u662F\u4ED6\u7684\u4FE1\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: char/mp02_default
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u83AB\u91CC\u68EE"
      Text: "\u8001\u8B66\u957F\uFF1F\u4ED6\u5728\u628A\u8B66\u957F\u7684\u4F4D\u7F6E\u4EA4\u7ED9\u6211\u4E4B\u540E\uFF0C\u5C31\u53BB\u5EA6\u5047\u4E86\uFF0C\u600E\u4E48\u4F1A\u6709\u4FE1\u7ED9\u6211\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: 
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u65C1\u767D"
      Text: "\u83AB\u91CC\u68EE\u68C0\u67E5\u4E86\u4FE1\u5C01\uFF0C\u72D0\u7591\u7684\u6253\u5F00\u4E86\u8001\u8B66\u957F\u7684\u4FE1\u4EF6"
    - LeftArtKey: char/mp01_default
      RightArtKey: 
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u4FE1\u4EF6\u6587\u672C"
      Text: "\u83AB\u91CC\u68EE\uFF0C\u6211\u77E5\u9053\u4F60\u770B\u5230\u8FD9\u5C01\u4FE1\u7684\u65F6\u5019\u4E00\u5B9A\u6478\u4E0D\u7740\u5934\u8111\uFF0C\u8B66\u957F\u8FD9\u4E8B\u60C5\u6CA1\u90A3\u4E48\u597D\u5E72\uFF0C\u5BF9\u5427\uFF1F"
    - LeftArtKey: char/mp01_default
      RightArtKey: 
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u4FE1\u4EF6\u6587\u672C"
      Text: "\u6211\u5728\u6E38\u8F6E\u4E0A\u8BA4\u8BC6\u4E86\u4E00\u4E2A\u4EBA\u3002\u4F60\u522B\u6487\u5634\uFF0C\u6211\u77E5\u9053\u4F60\u8BA8\u538C\u5927\u6D77\uFF0C\u4F46\u4F60\u8001\u4E0A\u53F8\u6211\u8FD9\u8F88\u5B50\u5C31\u8FD9\u70B9\u51FA\u606F\uFF0C\u9000\u4F11\u91D1\u4E0D\u82B1\u5728\u8D4C\u684C\u4E0A\u5C31\u5F97\u82B1\u5728\u7532\u677F\u4E0A\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: 
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u4FE1\u4EF6\u6587\u672C"
      Text: "\u603B\u4E4B\uFF0C\u8239\u4E0A\u6709\u4E2A\u5973\u4EBA\u53EB\u96EA\u8389\uFF0C\u5199\u5C0F\u8BF4\u7684\uFF0C\u5979\u662F\u4E2A\u5341\u5206\u654F\u9510\u7684\u4EBA\uFF0C\u4E00\u5B9A\u80FD\u5E2E\u52A9\u5230\u4F60\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: 
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u4FE1\u4EF6\u6587\u672C"
      Text: "\u867D\u7136\u8BF4\uFF0C\u5979\u6CA1\u6478\u8FC7\u67AA\uFF0C\u6CA1\u89C1\u8FC7\u5C38\u4F53\uFF0C\u66F4\u4E0D\u80FD\u50CF\u4F60\u4E00\u6837\u548C\u8FFD\u6355\u7F6A\u72AF\uFF0C\u548C\u7F6A\u72AF\u640F\u6597\uFF0C\u4F46\u662F\u5979\uFF0C\u563F\u563F\uFF0C\u6211\u5148\u4FDD\u4E2A\u5BC6\uFF0C\u5979\u4E00\u5B9A\u4F1A\u7ED9\u4F60\u60CA\u559C\u7684\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: 
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u4FE1\u4EF6\u6587\u672C"
      Text: "\u96EA\u8389\u6253\u7B97\u6765\u65AF\u5A01\u514B\u6536\u96C6\u8D44\u6599\uFF0C\u6211\u5DF2\u7ECF\u8DDF\u4E0A\u9762\u6253\u8FC7\u62DB\u547C\u4E86\uFF0C\u8BA9\u96EA\u8389\u505A\u4F60\u7684\u526F\u624B\uFF0C\u4F60\u53EF\u4E00\u5B9A\u4E0D\u80FD\u62D2\u7EDD\u554A\u3002"
    - LeftArtKey: char/mp01_default
      RightArtKey: 
      LeftDimmed: 1
      RightDimmed: 0
