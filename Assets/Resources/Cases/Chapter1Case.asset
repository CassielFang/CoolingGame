      Text: "\u6211\u6CA1\u6709\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u96EA\u8389"
      Text: "\u6CA1\u6709\u4EC0\u4E48\uFF1F\u6CA1\u6709\u6740\u4EBA\uFF0C\u8FD8\u662F\u6CA1\u6709\u60F3\u8FC7\u8FD9\u6837\u7684\u597D\u4E8B\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u585E\u5FB7\u91CC\u514B"
      Text: "\u6211\uFF0C\u6211\u4E0D\u4F1A\u7528\u8FD9\u6837\u7684\u624B\u6BB5\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u96EA\u8389"
      Text: "\u6CA1\u5173\u7CFB\uFF0C\u73B0\u5728\u4E5F\u53EA\u80FD\u60F3\u60F3\uFF0C\u8FD9\u6837\u7684\u4E8B\u5DF2\u7ECF\u4E0D\u4F1A\u53D1\u751F\u4E86\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 1
      RightDimmed: 1
      Speaker: "\u65C1\u767D"
      Text: "\u96EA\u8389\u6709\u610F\u505C\u987F\u4E86\u4E00\u4E0B\uFF0C\u770B\u7740\u585E\u5FB7\u91CC\u514B\u7684\u53CD\u5E94\uFF0C\u4F46\u585E\u5FB7\u91CC\u514B\u5728\u521A\u521A\u7684\u53CD\u9A73\u540E\uFF0C\u5C31\u53C8\u6062\u590D\u4E86\u5148\u524D\u7684\u6C89\u9ED8\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u96EA\u8389"
      Text: "\u521A\u521A\u6709\u4E00\u4E2A\u4EBA\u6765\u81EA\u9996\u4E86\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u96EA\u8389"
      Text: "\u4ED6\u62FF\u51FA\u4E86\u6740\u6B7B\u7EA6\u7FF0\xB7\u5361\u6797\u987F\u65F6\u7684\u8863\u7269\uFF0C\u73B0\u5728\u6240\u6709\u7684\u6CE8\u610F\u529B\u90FD\u4F1A\u96C6\u4E2D\u5230\u4ED6\u7684\u8EAB\u4E0A\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u96EA\u8389"
      Text: "\u6765\u81EA\u9996\u7684\u4EBA\uFF0C\u5C31\u662F\u6536\u7559\u4F60\u7684\u54C8\u7F57\u5FB7\u795E\u7236\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 1
      RightDimmed: 0
      Speaker: "\u65C1\u767D"
      Text: "\u585E\u5FB7\u91CC\u514B\u4F9D\u7136\u51DD\u89C6\u7740\u81EA\u5DF1\u88AB\u94D0\u4F4F\u7684\u53CC\u624B\uFF0C\u4F46\u542C\u5230\u8FD9\u91CC\uFF0C\u4E0D\u81EA\u89C9\u7684\u8F7B\u8F7B\u7684\u62BD\u4E86\u4E00\u4E0B\u9F3B\u5B50\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 1
      RightDimmed: 1
      Speaker: "\u65C1\u767D"
      Text: "\u8FD9\u4E2A\u52A8\u4F5C\u6CA1\u6709\u9003\u8FC7\u96EA\u8389\u7684\u773C\u775B\uFF0C\u83AB\u91CC\u68EE\u4E5F\u9690\u7EA6\u610F\u8BC6\u5230\uFF0C\u96EA\u8389\u7684\u8BED\u8A00\u7B56\u7565\u53EF\u80FD\u6BD4\u81EA\u5DF1\u7684\u5A01\u80C1\u66F4\u6709\u7528\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u96EA\u8389"
      Text: "\u4F60\u7684\u753B\u6211\u4EEC\u5728\u6559\u5802\u770B\u8FC7\uFF0C\u4E0D\u5F97\u4E0D\u8BF4\uFF0C\u4EE5\u4F60\u7684\u5E74\u9F84\uFF0C\u4F60\u7684\u6280\u827A\u8DB3\u79F0\u7CBE\u6DF1\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u96EA\u8389"
      Text: "\u5982\u679C\u6709\u8BC4\u8BBA\u5BB6\u7ED9\u51FA\u9AD8\u8BC4\u4EF7\uFF0C\u6216\u8005\u6709\u4EBA\u7528\u5927\u4EF7\u94B1\u4E70\u4E0B\uFF0C\u4FBF\u53EF\u4EE5\u51FA\u4EBA\u5934\u5730\uFF0C\u751A\u81F3\u6709\u673A\u4F1A\u540D\u7559\u827A\u672F\u53F2\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u96EA\u8389"
      Text: "\u4F46\u662F\u6CA1\u6709\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u96EA\u8389"
      Text: "\u6CA1\u6709\u4EBA\u8D4F\u8BC6\u4F60\uFF0C\u6CA1\u6709\u4EBA\u8BA4\u53EF\u4F60\u7684\u753B\uFF0C\u4F60\u4E00\u6B21\u6B21\u78B0\u58C1\uFF0C\u4E00\u5E74\u5E74\u8E49\u8DCE\u5C81\u6708\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u96EA\u8389"
      Text: "\u5728\u8017\u5C3D\u8D22\u5BCC\u548C\u8010\u5FC3\u4E4B\u540E\uFF0C\u4F60\u5F00\u59CB\u53CD\u601D\uFF0C\u4E5F\u8BB8\u5F00\u59CB\u65F6\uFF0C\u4F60\u60F3\u7684\u662F\u81EA\u5DF1\u7684\u753B\u6280\u5C1A\u4E0D\u6210\u719F\uFF0C\u81EA\u5DF1\u7684\u98CE\u683C\u8FD8\u4E0D\u591F\u6709\u7279\u8272\u3002"
    - LeftArtKey: char/mp02_default
      RightArtKey: char/p01_cedric
      LeftDimmed: 0
      RightDimmed: 1
      Speaker: "\u96EA\u8389"
      Text: "\u65F6\u95F4\u957F\u4E86\uFF0C\u4F60\u5F00\u59CB\u618E\u6068\u90A3\u4E9B\u5BCC\u4EBA\uFF0C\u90A3\u4E9B\u4E0D\u8BC6\u8D27\u7684\u5BB6\u4F19\uFF0C\u90A3\u4E9B\u4E0D\u660E\u767D\u4F60\u4F5C\u54C1\u4EF7\u503C\uFF0C\u9AD8\u9AD8\u5728\u4E0A\u7684\u5BB6\u4F19\uFF0C\u5C24\u5176\u662F\uFF0C\u4ED6\u4EEC\u8FD8\u6765\u6559\u5802\u7948\u7977\uFF0C\u8FD8\u53BB\u505A\u6148\u5584\uFF0C\u771F\u662F\u865A\u4F2A\u554A\u3002"
